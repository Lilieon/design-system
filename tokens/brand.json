      "$type": "number",
      "$value": 1.5
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.625
    }
  },
  "radius": {
    "$description": "Charte: quiet, moderately rounded surfaces (sm for controls, lg for cards).",
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "10px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
