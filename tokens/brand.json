    "xl": {
      "$type": "dimension",
      "$value": "28px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "$description": "Charte: subtle depth only — shadows whisper, borders speak.",
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "x": 0,
          "y": 1,
          "blur": 2,
          "spread": 0,
          "color": "rgba(0, 0, 0, 0.05)"
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "x": 0,
          "y": 1,
          "blur": 3,
          "spread": 0,
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "x": 0,
          "y": 2,
          "blur": 6,
          "spread": -1,
          "color": "rgba(0, 0, 0, 0.06)"
        }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "x": 0,
          "y": 4,
          "blur": 6,
          "spread": -1,
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "x": 0,
          "y": 10,
          "blur": 15,
          "spread": -3,
          "color": "rgba(0, 0, 0, 0.08)"
        }
      ]
    }
  },
  "duration": {
    "$description": "Charte: quick, purposeful motion (120–280ms).",
    "fast": {
      "$type": "duration",
      "$value": "140ms"
    },
    "base": {
      "$type": "duration",
      "$value": "220ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "340ms"
    }
  },
  "easing": {
    "$description": "Charte: standard ease for most transitions, emphasized for large surfaces.",
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  }
