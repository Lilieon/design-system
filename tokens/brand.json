  "font": {
    "$description": "Charte: type families. Inter for UI, system mono for code.",
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "fontSize": {
    "$description": "Charte: type scale (12 to 36px), compact and UI-oriented.",
    "xs": {
      "$type": "dimension",
      "$value": "12px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "14px"
    },
    "base": {
      "$type": "dimension",
      "$value": "16px"
