      "$type": "dimension",
      "$value": "24px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "30px"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "36px"
    }
  },
  "fontWeight": {
    "$description": "Charte: four weights only — hierarchy by weight is restrained.",
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "lineHeight": {
    "$description": "Charte: line heights tighten as text size grows.",
    "tight": {
      "$type": "number",
      "$value": 1.25
    },
    "snug": {
      "$type": "number",
      "$value": 1.375
    },
    "normal": {
      "$type": "number",
      "$value": 1.5
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.625
    }
  },
  "radius": {
    "$description": "Charte: quiet, moderately rounded surfaces (sm for controls, lg for cards).",
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "2px"
    },
    "md": {
      "$type": "dimension",
      "$value": "4px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "6px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "8px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "$description": "Charte: subtle depth only — shadows whisper, borders speak.",
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "x": 0,
          "y": 1,
          "blur": 2,
          "spread": 0,
          "color": "rgba(0, 0, 0, 0.05)"
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "x": 0,
          "y": 1,
          "blur": 3,
          "spread": 0,
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "x": 0,
          "y": 2,
          "blur": 6,
          "spread": -1,
          "color": "rgba(0, 0, 0, 0.06)"
        }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "x": 0,
          "y": 4,
          "blur": 6,
          "spread": -1,
          "color": "rgba(0, 0, 0, 0.08)"
        },
        {
          "x": 0,
          "y": 10,
          "blur": 15,
          "spread": -3,
          "color": "rgba(0, 0, 0, 0.08)"
        }
      ]
    }
  },
  "duration": {
    "$description": "Charte: quick, purposeful motion (120–280ms).",
    "fast": {
      "$type": "duration",
      "$value": "80ms"
    },
    "base": {
      "$type": "duration",
      "$value": "120ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "180ms"
    }
  },
  "easing": {
    "$description": "Charte: standard ease for most transitions, emphasized for large surfaces.",
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  }
}
