      "$type": "fontFamily",
      "$value": [
        "ui-rounded",
        "SF Pro Rounded",
        "Nunito",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "fontSize": {
    "$description": "Charte: type scale (12 to 36px), compact and UI-oriented.",
