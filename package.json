{
  "name": "@lilieon/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Personal design system: DTCG design tokens, Angular + Tailwind CSS v4 components, shadcn-style registry, and AI agent integrations.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "ng": "ng",
    "build": "pnpm build:tokens && pnpm build:registry && pnpm build:playground",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:playground": "ng build playground",
    "test": "pnpm test:scripts && pnpm test:components",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:components": "ng test",
    "test:mcp": "node mcp/smoke.mjs",
    "mcp": "node mcp/server.mjs",
    "start": "ng serve playground",
    "storybook": "ng run playground:storybook",
    "build:storybook": "ng run playground:build-storybook"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "class-variance-authority": "^0.7.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular": "^10.6.2",
    "@tailwindcss/postcss": "^4.1.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.111.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
